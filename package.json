{
  "name": "hit-me-up-agent",
  "version": "0.1.0",
  "description": "HIT-ME-UP automation agent: chat, tool use, scheduled jobs, webhooks, notifications, and memory. TypeScript / Node.js.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js --server",
    "server": "node dist/index.js --server",
    "cli": "node dist/index.js --cli",
    "once": "node dist/index.js --once",
    "test": "tsc && node --test \"dist/test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
